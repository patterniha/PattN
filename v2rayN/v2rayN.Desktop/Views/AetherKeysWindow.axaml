<Window
    x:Class="v2rayN.Desktop.Views.AetherKeysWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.TbAetherGetKeys}"
    Width="900"
    Height="700"
    x:DataType="vms:AetherKeysViewModel"
    Design.DataContext="{x:Static dd:DesignData.AetherKeys}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  PattN: fork-only window, the WARP keys window (design 3.4): its own settings, saved as they change, in PattNG's order, then the run, the command and the log  -->
    <!--  A label beside a field taller than one line sits at the top, 10 px down (16 beside an expander), level with the  -->
    <!--  field's first line; a hint beside a switch keeps 4 px above and below, apart from the hint of the next row  -->
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnClose"
                MinWidth="100"
                Content="{x:Static resx:ResUI.menuClose}"
                IsCancel="True" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  1-8. The settings, which a run locks while it goes on  -->
                <StackPanel x:Name="panelSettings">
                    <!--  1. Get new keys for: every key, or one protocol's  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Top"
                            Text="{x:Static resx:ResUI.TbAetherKeysKind}"
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="lstKinds" Grid.Column="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vms:AetherKeyKindOption">
                                    <RadioButton
                                        Margin="{StaticResource Margin4}"
                                        Content="{Binding Label}"
                                        GroupName="AetherKeysKind"
                                        IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!--  2. API address; under each API field, default while it is blank, as under a preset field  -->
                    <Grid ColumnDefinitions="300,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiAddress}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiAddress"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True"
                            PlaceholderText="{x:Static resx:ResUI.TbAetherKeysApiAddressHint}" />
                        <TextBlock
                            x:Name="txtApiAddressHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLr8}"
                            HorizontalAlignment="Left"
                            IsVisible="False"
                            Opacity="0.7" />
                    </Grid>

                    <!--  2b. API server name, which a blank leaves to the host  -->
                    <Grid ColumnDefinitions="300,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiSni}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiSni"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True"
                            PlaceholderText="{x:Static resx:ResUI.TbAetherKeysApiSniHint}" />
                        <TextBlock
                            x:Name="txtApiSniHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLr8}"
                            HorizontalAlignment="Left"
                            IsVisible="False"
                            Opacity="0.7" />
                    </Grid>

                    <!--  2c. API host, the core's own while blank: default under it, then its hint  -->
                    <Grid ColumnDefinitions="300,Auto" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiHost}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiHost"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True" />
                        <TextBlock
                            x:Name="txtApiHostHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLr8}"
                            HorizontalAlignment="Left"
                            IsVisible="False"
                            Opacity="0.7" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiHostHint}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  3. Fragment ClientHello of the calls to the WARP API  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherFragment}"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleSwitch
                                x:Name="togFragment"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Width="400"
                                Margin="8,4"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbAetherKeysFragmentHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  3a. Fragment size, the core's own while blank  -->
                    <Grid x:Name="rowFragmentSize" ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherFragmentSize}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="txtFragmentSize"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            PlaceholderText="8-16" />
                    </Grid>

                    <!--  3b. Fragment delay  -->
                    <Grid x:Name="rowFragmentDelay" ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherFragmentDelay}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="txtFragmentDelay"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            PlaceholderText="2-10" />
                    </Grid>

                    <!--  4. Encrypted Client Hello on the calls to the WARP API  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherEch}"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleSwitch
                                x:Name="togEch"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Width="400"
                                Margin="8,4"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbAetherKeysEchHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  4a. ECH DNS: a list to pick from that takes any other value the core does as well, as in the editor  -->
                    <Grid x:Name="rowEchDns" ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherEchDns}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbEchDns"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True" />
                    </Grid>

                    <!--  4b. ECH domain  -->
                    <Grid x:Name="rowEchDomain" ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherEchDomain}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbEchDomain"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            IsEditable="True" />
                    </Grid>

                    <!--  5. Fingerprint, always sent: every call to the WARP API is TLS over TCP  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherFingerprint}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbFingerprint"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                    </Grid>

                    <!--  6. exit-node  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,10,4,4"
                            VerticalAlignment="Top"
                            Text="{x:Static resx:ResUI.TbAetherExitNode}"
                            TextWrapping="Wrap" />
                        <views:ExitNodeField x:Name="exitNodeField" Grid.Column="1" />
                    </Grid>

                    <!--  7. exit-node finalMask, for freedom  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,10,4,4"
                            VerticalAlignment="Top"
                            Text="{x:Static resx:ResUI.TbAetherExitFinalMask}"
                            TextWrapping="Wrap" />
                        <views:PresetField
                            x:Name="presetFinalMask"
                            Grid.Column="1"
                            IsMultiline="True" />
                    </Grid>

                    <!--  8. exit-node dialMode, for freedom  -->
                    <Grid ColumnDefinitions="300,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,10,4,4"
                            VerticalAlignment="Top"
                            Text="{x:Static resx:ResUI.TbAetherExitDialMode}"
                            TextWrapping="Wrap" />
                        <views:PresetField x:Name="presetDialMode" Grid.Column="1" />
                    </Grid>
                </StackPanel>

                <!--  9. Get new WARP keys, and while a run goes on, Cancel beside it  -->
                <Grid ColumnDefinitions="300,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Name="btnGetKeys"
                            MinWidth="160"
                            Margin="{StaticResource Margin4}" />
                        <ProgressBar
                            x:Name="barRenewing"
                            Width="80"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            IsIndeterminate="True" />
                        <Button
                            x:Name="btnCancelRenew"
                            Margin="{StaticResource Margin4}"
                            Content="{x:Static resx:ResUI.TbCancel}" />
                    </StackPanel>
                </Grid>

                <!--  10. A session keeps the keys it uses; the keys of the other protocols can change under it  -->
                <Grid x:Name="rowBlocked" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Opacity="0.7"
                        Text="{x:Static resx:ResUI.MsgAetherRenewBlocked}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  11. No Aether core in the core folder  -->
                <Grid x:Name="rowCoreUnavailable" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Foreground="IndianRed"
                        Text="{x:Static resx:ResUI.MsgAetherCoreUnavailable}"
                        TextWrapping="Wrap" />
                </Grid>

                <Separator Margin="{StaticResource MarginTb8}" />

                <!--  12. The command the core is started with, built from the settings above and open to a hand  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherCommand}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1">
                        <TextBox
                            x:Name="txtCommand"
                            Width="500"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Classes="TextArea"
                            FontFamily="Cascadia Code,Consolas,Monospace"
                            MaxLines="8"
                            MinLines="3"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="panelCommandCustom">
                            <TextBlock
                                Width="500"
                                Margin="{StaticResource MarginLr8}"
                                HorizontalAlignment="Left"
                                Text="{x:Static resx:ResUI.TbAetherCommandCustom}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="btnUseSettings"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                Content="{x:Static resx:ResUI.TbAetherUseSettings}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  13. Log: the core's output and the keys in use  -->
                <!--  As wide as the label column and the command box: inside the horizontal ScrollViewer a log without a width of its own would take the width of its longest line and never wrap  -->
                <views:AetherLogPanel
                    x:Name="logPanel"
                    Width="808"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
