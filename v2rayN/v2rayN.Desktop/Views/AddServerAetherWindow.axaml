<Window
    x:Class="v2rayN.Desktop.Views.AddServerAetherWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuServers}"
    Width="900"
    Height="700"
    x:DataType="vms:AddServerAetherViewModel"
    Design.DataContext="{x:Static dd:DesignData.AddServerAether}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  PattN: fork-only window, the Aether editor (design 3.2): one row per setting, in PattNG's order, each shown as its settings call for  -->
    <!--  A label beside a field taller than one line sits at the top, 10 px down (16 beside an expander), level with the  -->
    <!--  field's first line; a hint beside a switch keeps 4 px above and below, apart from the hint of the next row  -->
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  1. The WARP keys are shared by every Aether profile and got in a window of their own  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.menuServers}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="btnRenewKey"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        Content="{x:Static resx:ResUI.TbAetherRenewKey}" />
                </Grid>

                <!--  2. Remarks  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbRemarks}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtRemarks"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  3. Protocol  -->
                <Grid x:Name="rowProtocol" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherProtocol}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbProtocol"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  4. Transport  -->
                <Grid x:Name="rowTransport" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherTransport}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbTransport"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  5. MASQUE SNI  -->
                <Grid x:Name="rowMasqueSni" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherMasqueSni}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtMasqueSni"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  6. Fragment ClientHello, over HTTP/2 chosen  -->
                <Grid x:Name="rowFragment" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherFragment}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="togFragment"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  7. Fragment size  -->
                <Grid x:Name="rowFragmentSize" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherFragmentSize}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtFragmentSize"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="8-16" />
                </Grid>

                <!--  8. Fragment delay  -->
                <Grid x:Name="rowFragmentDelay" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherFragmentDelay}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtFragmentDelay"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="2-10" />
                </Grid>

                <!--  9. Encrypted Client Hello  -->
                <Grid x:Name="rowEch" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherEch}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleSwitch
                            x:Name="togEch"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Width="400"
                            Margin="8,4"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherEchHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  10. ECH DNS: a list to pick from that takes any other value the core does as well  -->
                <Grid x:Name="rowEchDns" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherEchDns}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbEchDns"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        IsEditable="True" />
                </Grid>

                <!--  11. ECH domain  -->
                <Grid x:Name="rowEchDomain" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherEchDomain}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbEchDomain"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        IsEditable="True" />
                </Grid>

                <!--  12. Scan mode  -->
                <Grid x:Name="rowScanMode" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherScanMode}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbScanMode"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  13. Obfuscation, not over HTTP/2  -->
                <Grid x:Name="rowObfuscation" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherObfuscation}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbObfuscation"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  14. Fingerprint, over MASQUE on either carrier  -->
                <Grid x:Name="rowFingerprint" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherFingerprint}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbFingerprint"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  15. exit-node  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherExitNode}"
                        TextWrapping="Wrap" />
                    <views:ExitNodeField x:Name="exitNodeField" Grid.Column="1" />
                </Grid>

                <!--  16. exit-node finalMask, for freedom  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherExitFinalMask}"
                        TextWrapping="Wrap" />
                    <views:PresetField
                        x:Name="presetFinalMask"
                        Grid.Column="1"
                        IsMultiline="True" />
                </Grid>

                <!--  17. exit-node dialMode, for freedom  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherExitDialMode}"
                        TextWrapping="Wrap" />
                    <views:PresetField x:Name="presetDialMode" Grid.Column="1" />
                </Grid>

                <!--  18. Psiphon  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphon}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbPsiphon"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  19. No Psiphon client in the core folder  -->
                <Grid x:Name="rowPsiphonUnavailable" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Foreground="IndianRed"
                        Text="{x:Static resx:ResUI.MsgAetherPsiphonUnavailable}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  20. Psiphon connection  -->
                <Grid x:Name="rowPsiphonMode" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonMode}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbPsiphonMode"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  21. CDN fronting IPs  -->
                <Grid x:Name="rowPsiphonCdnIps" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonCdnIps}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtPsiphonCdnIps"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="{x:Static resx:ResUI.TbAetherPsiphonListHint}" />
                </Grid>

                <!--  22. CDN fronting server names, beside IPs of one's own  -->
                <Grid x:Name="rowPsiphonCdnSni" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonCdnSni}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtPsiphonCdnSni"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="{x:Static resx:ResUI.TbAetherPsiphonListHint}" />
                </Grid>

                <!--  23. CDN edge lists to scan, folded behind a line that names the choice  -->
                <Grid x:Name="rowPsiphonCdnSets" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,16,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonCdnSets}"
                        TextWrapping="Wrap" />
                    <Expander
                        x:Name="expPsiphonCdnSets"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left">
                        <Expander.Header>
                            <TextBlock
                                x:Name="txtPsiphonCdnSetsSummary"
                                FontWeight="Normal"
                                TextWrapping="Wrap" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                Opacity="0.7"
                                Text="{x:Static resx:ResUI.TbAetherPsiphonCdnSetsHint}"
                                TextWrapping="Wrap" />
                            <ItemsControl x:Name="lstPsiphonCdnSets">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vms:AetherCdnSetOption">
                                        <CheckBox
                                            Margin="{StaticResource Margin4}"
                                            Content="{Binding Label}"
                                            IsChecked="{Binding IsChecked}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </Grid>

                <!--  24. Exit country  -->
                <Grid x:Name="rowPsiphonRegion" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonRegion}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbPsiphonRegion"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        MaxDropDownHeight="1000" />
                </Grid>

                <!--  25. Start from the bundled server list  -->
                <Grid x:Name="rowPsiphonBundledList" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherPsiphonBundledList}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleSwitch
                            x:Name="togPsiphonBundledList"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Width="400"
                            Margin="8,4"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:ResUI.TbAetherPsiphonBundledListHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  26. Clear Psiphon data, shared by every profile, only while no session runs on it  -->
                <Grid x:Name="rowClearPsiphon" ColumnDefinitions="300,Auto">
                    <StackPanel Grid.Column="1">
                        <Button
                            x:Name="btnClearPsiphon"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            Content="{x:Static resx:ResUI.TbAetherClearPsiphon}" />
                        <TextBlock
                            Width="400"
                            Margin="{StaticResource MarginLr8}"
                            HorizontalAlignment="Left"
                            Opacity="0.7"
                            Text="{x:Static resx:ResUI.TbAetherClearPsiphonHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  27. Tor  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherTor}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbTor"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  28. No pluggable transport in the core folder  -->
                <Grid x:Name="rowTorTransportsUnavailable" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Foreground="IndianRed"
                        Text="{x:Static resx:ResUI.MsgAetherTorTransportsUnavailable}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  29. Bridges  -->
                <Grid x:Name="rowTorBridges" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherTorBridges}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbTorBridges"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  30. Bridge sources  -->
                <Grid x:Name="rowTorRelays" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherTorRelays}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbTorRelays"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  31. Bridge lines of one's own  -->
                <Grid x:Name="rowTorBridgeLines" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherTorBridgeLines}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtTorBridgeLines"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        AcceptsReturn="True"
                        Classes="TextArea"
                        MaxLines="6"
                        MinLines="3"
                        PlaceholderText="{x:Static resx:ResUI.TbAetherTorBridgeLinesHint}"
                        TextWrapping="NoWrap" />
                </Grid>

                <!--  32/33. Outer and inner hop of a two-hop protocol  -->
                <Grid x:Name="rowOuterHop" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherOuterHop}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtWiwOuter"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="{x:Static resx:ResUI.TbAetherEndpointHint}" />
                </Grid>
                <Grid x:Name="rowInnerHop" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherInnerHop}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtWiwInner"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  32'/33'. Address and port of a one-hop protocol: blank to scan  -->
                <Grid x:Name="rowAddress" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAddress}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtAddress"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        PlaceholderText="{x:Static resx:ResUI.TbAetherEndpointHint}" />
                </Grid>
                <Grid x:Name="rowPort" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbPort}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="txtPort"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  34. IP version, just before the scan  -->
                <Grid x:Name="rowIpVersion" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAetherIpVersion}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="cmbIpVersion"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>

                <!--  35-38. Other settings, folded away unless one holds a value of its own  -->
                <Expander
                    x:Name="expOtherSettings"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Stretch"
                    Header="{x:Static resx:ResUI.TbAetherOtherSettings}">
                    <StackPanel>
                        <Grid x:Name="rowDns" ColumnDefinitions="280,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbAetherDns}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="txtDns"
                                Grid.Column="1"
                                Width="400"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                PlaceholderText="{x:Static resx:ResUI.TbAetherDnsHint}" />
                        </Grid>
                        <Grid x:Name="rowExitLoc" ColumnDefinitions="280,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbAetherExitLoc}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="txtExitLoc"
                                Grid.Column="1"
                                Width="400"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                PlaceholderText="{x:Static resx:ResUI.TbAetherExitLocHint}" />
                        </Grid>
                        <!--  The tcpUserTimeout of the freedom exit-node, only where the core connects out over TCP  -->
                        <Grid x:Name="rowTcpUserTimeout" ColumnDefinitions="280,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbAetherExitTcpUserTimeout}"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="txtTcpUserTimeout"
                                Grid.Column="1"
                                Width="400"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                PlaceholderText="{x:Static resx:ResUI.TbTcpUserTimeoutHint}" />
                        </Grid>
                        <Grid ColumnDefinitions="280,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static resx:ResUI.TbTargetStrategy}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="cmbTargetStrategy"
                                Grid.Column="1"
                                Width="200"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!--  39-41. Scan, after every setting it runs on  -->
                <Grid x:Name="rowScan" ColumnDefinitions="300,Auto">
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Name="btnScan"
                            MinWidth="160"
                            Margin="{StaticResource Margin4}" />
                        <ProgressBar
                            x:Name="barScanning"
                            Width="80"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            IsIndeterminate="True" />
                        <Button
                            x:Name="btnCancelScan"
                            Margin="{StaticResource Margin4}"
                            Content="{x:Static resx:ResUI.TbCancel}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="rowScanBlocked" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Opacity="0.7"
                        Text="{x:Static resx:ResUI.MsgAetherScanBlocked}"
                        TextWrapping="Wrap" />
                </Grid>
                <Grid x:Name="rowCoreUnavailable" ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Foreground="IndianRed"
                        Text="{x:Static resx:ResUI.MsgAetherCoreUnavailable}"
                        TextWrapping="Wrap" />
                </Grid>

                <Separator Margin="{StaticResource MarginTb8}" />

                <!--  42. The command the core is started with, built from the settings above and open to a hand  -->
                <Grid ColumnDefinitions="300,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="4,10,4,4"
                        VerticalAlignment="Top"
                        Text="{x:Static resx:ResUI.TbAetherCommand}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1">
                        <TextBox
                            x:Name="txtCommand"
                            Width="500"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            Classes="TextArea"
                            FontFamily="Cascadia Code,Consolas,Monospace"
                            MaxLines="8"
                            MinLines="3"
                            TextWrapping="Wrap" />
                        <StackPanel x:Name="panelCommandCustom">
                            <TextBlock
                                Width="500"
                                Margin="{StaticResource MarginLr8}"
                                HorizontalAlignment="Left"
                                Text="{x:Static resx:ResUI.TbAetherCommandCustom}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="btnUseSettings"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                Content="{x:Static resx:ResUI.TbAetherUseSettings}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  43. Log  -->
                <!--  As wide as the label column and the command box: inside the horizontal ScrollViewer a log without a width of its own would take the width of its longest line and never wrap  -->
                <views:AetherLogPanel
                    x:Name="logPanel"
                    Width="808"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
