<base:WindowBase
    x:Class="v2rayN.Views.AetherKeysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:views="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.TbAetherGetKeys}"
    Width="900"
    Height="750"
    x:TypeArguments="vms:AetherKeysViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  PattN: fork-only window, the WARP keys window (design 3.4): its own settings, saved as they change, in PattNG's order, then the run, the command and the log  -->
    <!--  A hint beside a switch keeps 4 px above and below, apart from the hint of the next row  -->
    <Window.Resources>
        <!--  The entries of the API fields go by the name the list shows, which is what a screen reader says: default's value is blank  -->
        <Style
            x:Key="ApiNameItem"
            BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}"
            TargetType="{x:Type ComboBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnClose"
                MinWidth="100"
                Content="{x:Static resx:ResUI.menuClose}"
                IsCancel="True"
                Style="{StaticResource DefButton}" />
        </StackPanel>
        <ScrollViewer
            materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  1-8. The settings, which a run locks while it goes on  -->
                <StackPanel x:Name="panelSettings">
                    <!--  1. Get new keys for: every key, or one protocol's  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Top"
                            Style="{StaticResource ModuleTitle}"
                            Text="{x:Static resx:ResUI.TbAetherKeysKind}"
                            TextWrapping="Wrap" />
                        <ItemsControl x:Name="lstKinds" Grid.Column="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="{StaticResource Margin4}"
                                        Content="{Binding Label}"
                                        GroupName="AetherKeysKind"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!--  2. API address; under each API field, default while it is blank, as under a preset field  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiAddress}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiAddress"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbAetherKeysApiAddressHint}"
                            DisplayMemberPath="Display"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            ItemContainerStyle="{StaticResource ApiNameItem}"
                            Style="{StaticResource DefComboBox}"
                            TextSearch.TextPath="Value" />
                        <TextBlock
                            x:Name="txtApiAddressHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLeftRight8}"
                            HorizontalAlignment="Left"
                            Opacity="0.7"
                            Style="{StaticResource ToolbarTextBlock}"
                            Visibility="Collapsed" />
                    </Grid>

                    <!--  2b. API server name, which a blank leaves to the host  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiSni}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiSni"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbAetherKeysApiSniHint}"
                            DisplayMemberPath="Display"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            ItemContainerStyle="{StaticResource ApiNameItem}"
                            Style="{StaticResource DefComboBox}"
                            TextSearch.TextPath="Value" />
                        <TextBlock
                            x:Name="txtApiSniHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLeftRight8}"
                            HorizontalAlignment="Left"
                            Opacity="0.7"
                            Style="{StaticResource ToolbarTextBlock}"
                            Visibility="Collapsed" />
                    </Grid>

                    <!--  2c. API host, the core's own while blank: default under it, then its hint  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiHost}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbApiHost"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            DisplayMemberPath="Display"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            ItemContainerStyle="{StaticResource ApiNameItem}"
                            Style="{StaticResource DefComboBox}"
                            TextSearch.TextPath="Value" />
                        <TextBlock
                            x:Name="txtApiHostHeld"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="{StaticResource MarginLeftRight8}"
                            HorizontalAlignment="Left"
                            Opacity="0.7"
                            Style="{StaticResource ToolbarTextBlock}"
                            Visibility="Collapsed" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherKeysApiHostHint}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  3. Fragment ClientHello of the calls to the WARP API  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherFragment}"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton
                                x:Name="togFragment"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Width="400"
                                Margin="8,4,8,4"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbAetherKeysFragmentHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  3a. Fragment size, the core's own while blank  -->
                    <Grid x:Name="rowFragmentSize">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherFragmentSize}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="txtFragmentSize"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.Hint="8-16"
                            Style="{StaticResource DefTextBox}" />
                    </Grid>

                    <!--  3b. Fragment delay  -->
                    <Grid x:Name="rowFragmentDelay">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherFragmentDelay}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="txtFragmentDelay"
                            Grid.Column="1"
                            Width="200"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.Hint="2-10"
                            Style="{StaticResource DefTextBox}" />
                    </Grid>

                    <!--  4. Encrypted Client Hello on the calls to the WARP API  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherEch}"
                            TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton
                                x:Name="togEch"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Width="400"
                                Margin="8,4,8,4"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbAetherKeysEchHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  4a. ECH DNS: a list to pick from that takes any other value the core does as well, as in the editor  -->
                    <Grid x:Name="rowEchDns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherEchDns}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbEchDns"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            Style="{StaticResource DefComboBox}" />
                    </Grid>

                    <!--  4b. ECH domain  -->
                    <Grid x:Name="rowEchDomain">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherEchDomain}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbEchDomain"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            Style="{StaticResource DefComboBox}" />
                    </Grid>

                    <!--  5. Fingerprint, always sent: every call to the WARP API is TLS over TCP  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherFingerprint}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="cmbFingerprint"
                            Grid.Column="1"
                            Width="400"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefComboBox}" />
                    </Grid>

                    <!--  6. exit-node  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherExitNode}"
                            TextWrapping="Wrap" />
                        <views:ExitNodeField x:Name="exitNodeField" Grid.Column="1" />
                    </Grid>

                    <!--  7. exit-node finalMask, for freedom  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherExitFinalMask}"
                            TextWrapping="Wrap" />
                        <views:PresetField
                            x:Name="presetFinalMask"
                            Grid.Column="1"
                            IsMultiline="True" />
                    </Grid>

                    <!--  8. exit-node dialMode, for freedom  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="{StaticResource Margin4}"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToolbarTextBlock}"
                            Text="{x:Static resx:ResUI.TbAetherExitDialMode}"
                            TextWrapping="Wrap" />
                        <views:PresetField x:Name="presetDialMode" Grid.Column="1" />
                    </Grid>
                </StackPanel>

                <!--  9. Get new WARP keys, and while a run goes on, Cancel beside it  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Name="btnGetKeys"
                            MinWidth="160"
                            Margin="{StaticResource Margin4}"
                            Style="{StaticResource DefButton}" />
                        <ProgressBar
                            x:Name="barRenewing"
                            Width="20"
                            Height="20"
                            Margin="{StaticResource Margin4}"
                            IsIndeterminate="True"
                            Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0" />
                        <Button
                            x:Name="btnCancelRenew"
                            Margin="{StaticResource Margin4}"
                            Content="{x:Static resx:ResUI.TbCancel}"
                            Style="{StaticResource DefButton}" />
                    </StackPanel>
                </Grid>

                <!--  10. A session keeps the keys it uses; the keys of the other protocols can change under it  -->
                <Grid x:Name="rowBlocked">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Opacity="0.7"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.MsgAetherRenewBlocked}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  11. No Aether core in the core folder  -->
                <Grid x:Name="rowCoreUnavailable">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Foreground="IndianRed"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.MsgAetherCoreUnavailable}"
                        TextWrapping="Wrap" />
                </Grid>

                <Separator Margin="0,2" Style="{DynamicResource MaterialDesignSeparator}" />

                <!--  12. The command the core is started with, built from the settings above and open to a hand  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Top"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbAetherCommand}"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1">
                        <TextBox
                            x:Name="txtCommand"
                            Width="500"
                            Margin="{StaticResource Margin4}"
                            HorizontalAlignment="Left"
                            AcceptsReturn="True"
                            FontFamily="Consolas, Courier New"
                            MaxLines="8"
                            MinLines="3"
                            Style="{StaticResource MyOutlinedTextBox}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <StackPanel x:Name="panelCommandCustom">
                            <TextBlock
                                Width="500"
                                Margin="{StaticResource MarginLeftRight8}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ToolbarTextBlock}"
                                Text="{x:Static resx:ResUI.TbAetherCommandCustom}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="btnUseSettings"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left"
                                Content="{x:Static resx:ResUI.TbAetherUseSettings}"
                                Style="{StaticResource DefButton}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  13. Log: the core's output and the keys in use  -->
                <!--  As wide as the label column and the command box: inside the horizontal ScrollViewer a log without a width of its own would take the width of its longest line and never wrap  -->
                <views:AetherLogPanel
                    x:Name="logPanel"
                    Width="808"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
