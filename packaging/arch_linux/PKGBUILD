# Maintainer: Your Name <you@example.com>
pkgname=pattn-bin
pkgver=7.24.8.P2
pkgrel=1
pkgdesc="v2rayN fork for Iranians (Binary file)"
arch=('x86_64')
url='https://github.com/patterniha/PattN'
license=('GPL-3.0-or-later')

depends=(
  'fontconfig'
  'hicolor-icon-theme'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxi'
  'libxinerama'
  'libxkbcommon'
  'libxkbcommon-x11'
  'libxrandr'
  'libxrender'
  'openssl'
)
makedepends=('binutils')

_tag=7.24.8-P2
source=("${pkgname}-${pkgver}.deb::https://github.com/patterniha/PattN/releases/download/${_tag}/PattN-linux-64.deb")
noextract=("${pkgname}-${pkgver}.deb")
sha256sums=('aab47965cc988642574a99b5025f5c7fc3f82d446a36a42ada284bbf7fc5aa06')

options=(!strip)

package() {
  cd "$srcdir"

  ar x "${pkgname}-${pkgver}.deb"
  tar -xf data.tar.* -C "$pkgdir"

  chmod 755 \
    "$pkgdir/opt/v2rayN/PattN" \
    "$pkgdir/opt/v2rayN/bin/sing_box/sing-box" \
    "$pkgdir/opt/v2rayN/bin/xray/xray"

  if [ -f "$pkgdir/usr/bin/v2rayn" ] && [ ! -L "$pkgdir/usr/bin/v2rayn" ]; then
    chmod 755 "$pkgdir/usr/bin/v2rayn"
  fi
}